      await service.authenticateUser(credentials);
    } catch (err) {
      error = err;
    }
    assert.ok(error instanceof Error, 'Authentication failed as expected');
  });

  it('should validate a valid session token', async function() {
    const credentials = { username: 'testuser', password: 'testpassword' };
    const token = await service.authenticateUser(credentials);
    const isValid = await service.validateToken(token);
    assert.strictEqual(isValid, true);
  });

