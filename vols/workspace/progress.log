import * as bcrypt from 'bcrypt';
import * as jwt from 'jsonwebtoken';

interface User {
  email: string;
  password: string;
  // Add additional user properties here
}

export class AuthService implements IAuthService {
  private users: User[] = [];
  private readonly secretKey: string = process.env.JWT_SECRET || 'default-secret-key';

  async signUp(user: User): Promise<void> {
    const existingUser = this.users.find((u) => u.email === user.email);
    if (existingUser) {
      throw new Error('Email already in use');
    }

    const salt = await bcrypt.genSalt(10);
    const hashedPassword = await bcrypt.hash(user.password, salt);
    this.users.push({ ...user, password: hashedPassword });
  }

  async logIn(email: string, password: string): Promise<User> {
    const user = this.users.find((u) => u.email === email);
    if (!user) {
      throw new Error('Invalid credentials');
    }

    const isPasswordValid = await bcrypt.compare(password, user.password);
    if (!isPasswordValid) {
      throw new Error('Invalid credentials');
    }

    const token = jwt.sign({ email: user.email }, this.secretKey, { expiresIn: '1h' });
    // Store the token in a secure place, such as an HTTP-only cookie or local storage

    return user;
  }
}
