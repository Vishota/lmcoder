🧠 Response for code (Authorization): // @>npm i jsonwebtoken@8.5.1 bcryptjs@2.4.3
import * as jwt from 'jsonwebtoken';
import * as bcrypt from 'bcryptjs';

export class AuthService implements AuthService {
  private users: User[] = []; // In-memory storage, replace with your database

  async login(username: string, password: string): Promise<User> {
    const user = this.users.find((u) => u.username === username);
    if (!user || !(await bcrypt.compare(password, user.password))) {
      throw new Error('Invalid credentials');
    }
    return user;
  }

  async register(userData: UserData): Promise<User> {
    const hashedPassword = await bcrypt.hash(userData.password, 10);
    const user: User = { ...userData, password: hashedPassword };
    this.users.push(user);
    return user;
  }
}
