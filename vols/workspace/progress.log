import assert from 'assert';
import { UserAuthenticationService } from './task1';

describe('UserAuthenticationService', () => {
  let service: UserAuthenticationService;

  beforeEach(() => {
    service = new UserAuthenticationService();
  });

  it('should register a user successfully', async () => {
    const userData = { username: 'testuser', password: 'password123' };
    const registeredUser = await service.register(userData);
    assert(registeredUser !== null, 'Registered user should not be null');
  });

  it('should throw an error when registering with existing username', async () => {
    const userData = { username: 'existinguser', password: 'password123' };
    await service.register(userData); // Register a user first
    try {
      await service.register(userData); // Try to register the same user again
      assert(false, 'Expected an error to be thrown');
    } catch (error) {
      assert(error !== null, 'Error should not be null');
      assert(error instanceof Error, 'Error should be of type Error');
    }
  });

  it('should login successfully with valid credentials', async () => {
    const userData = { username: 'testuser', password: 'password123' };
    await service.register(userData); // Register a user first
    const loggedInUser = await service.login({ username: 'testuser', password: 'password123' });
    assert(loggedInUser !== null, 'Logged in user should not be null');
  });

  it('should throw an error when logging in with invalid credentials', async () => {
    const userData = { username: 'testuser', password: 'password123' };
    await service.register(userData); // Register a user first
    try {
      await service.login({ username: 'testuser', password: 'wrongpassword' });
      assert(false, 'Expected an error to be thrown');
    } catch (error) {
      assert(error !== null, 'Error should not be null');
      assert(error instanceof Error, 'Error should be of type Error');
    }
  });
});
