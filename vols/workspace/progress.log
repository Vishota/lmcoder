// @>npm i jsonwebtoken@^8.5.1
import jwt from 'jsonwebtoken';

interface UserData { username: string; password: string; }
interface Credentials { username: string; password: string; }
interface User { id: number; username: string; token?: string; }

export class AuthorizationService {
    private users: User[] = [];

    async register(userData: UserData): Promise<User> {
        const userExists = this.users.find(u => u.username === userData.username);
        if (userExists) throw new Error('Username already taken');

        const userId = this.users.length + 1;
        const token = jwt.sign({ id: userId }, 'secret', { expiresIn: '1h' });

        const user = { ...userData, id: userId, token };
        this.users.push(user);

        return user;
    }

    async login(credentials: Credentials): Promise<User> {
        const user = this.users.find(u => u.username === credentials.username && u.password === credentials.password);
        if (!user) throw new Error('Invalid username or password');

        const token = jwt.sign({ id: user.id }, 'secret', { expiresIn: '1h' });

        return { ...user, token };
    }
}
```
