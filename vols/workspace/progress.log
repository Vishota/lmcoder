// @>npm i bcryptjs@2.4.3 jsonwebtoken@8.5.1
import * as bcrypt from 'bcryptjs';
import * as jwt from 'jsonwebtoken';

interface User {
  id: string;
  email: string;
  password: string;
}

class AuthService implements IAuthService {
  private users: Map<string, User> = new Map();
  private secretKey: string = 'your-secret-key';

  async signUp(user: User): Promise<void> {
    const hashedPassword = await bcrypt.hash(user.password, 10);
    this.users.set(user.id, { ...user, password: hashedPassword });
  }

  async logIn(email: string, password: string): Promise<User> {
    const user = Array.from(this.users.values()).find((u) => u.email === email);
    if (!user || !(await bcrypt.compare(password, user.password))) {
      throw new Error('Invalid credentials');
    }
    const token = jwt.sign({ userId: user.id }, this.secretKey);
    console.log(`User ${user.id} logged in with token: ${token}`);
    return user;
  }
}

export default AuthService;
```
