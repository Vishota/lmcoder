    const invalidToken = jwt.sign({ username: 'testuser' }, 'invalid_secret');
    let error;
    try {
      await service.validateToken(invalidToken);
    } catch (err) {
      error = err;
    }
    assert.ok(error instanceof Error, 'Token validation failed as expected');
  });
});
