// @>npm i bcrypt@5.0.1 jsonwebtoken@8.5.1
import * as bcrypt from 'bcrypt';
import * as jwt from 'jsonwebtoken';

interface User {
  id?: string;
  email: string;
  password: string;
}

export class AuthService implements IAuthService {
  private users: User[] = [];
  private secretKey = 'your-secret-key'; // Replace with your own secret key

  async signUp(user: User): Promise<void> {
    const hashedPassword = await bcrypt.hash(user.password, 10);
    this.users.push({ ...user, password: hashedPassword });
  }

  async logIn(email: string, password: string): Promise<User> {
    const user = this.users.find((u) => u.email === email);
    if (!user || !(await bcrypt.compare(password, user.password))) {
      throw new Error('Invalid credentials');
    }
    const token = jwt.sign({ userId: user.id }, this.secretKey);
    return { ...user, password: undefined, token };
  }
}
