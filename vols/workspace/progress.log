import * as bcrypt from 'bcryptjs';
import * as jwt from 'jsonwebtoken';

export interface User {
    id: string;
    username: string;
}

export class AuthorizationService {
    private users: User[] = [];
    private secretKey = 'your_secret_key'; // Replace with a real secret key

    async register(userData): Promise<User> {
        const hashedPassword = await bcrypt.hash(userData.password, 10);
        const user: User = { id: Date.now().toString(), username: userData.username };
        this.users.push({ ...user, password: hashedPassword });
        return user;
    }

    async login(credentials): Promise<User | null> {
        const user = this.users.find(u => u.username === credentials.username);
        if (!user) return null;

        const isValidPassword = await bcrypt.compare(credentials.password, user.password);
        if (!isValidPassword) return null;

        const token = jwt.sign({ id: user.id, username: user.username }, this.secretKey);
        // You can use the token for further authentication in your application
        return { ...user, password: undefined };
    }
}
