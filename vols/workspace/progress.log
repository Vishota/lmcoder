import * as jwt from 'jsonwebtoken';
import * as bcrypt from 'bcryptjs';

interface User {
  id: string;
  email: string;
  password: string;
}

export class AuthService implements IAuthService {
  private users: User[] = [];
  private secretKey: string = 'secret-key';

  async signUp(user: User): Promise<void> {
    const hashedPassword = await bcrypt.hash(user.password, 10);
    this.users.push({ ...user, password: hashedPassword });
  }

  async logIn(email: string, password: string): Promise<User | null> {
    const user = this.users.find((u) => u.email === email);
    if (!user) return null;

    const isMatch = await bcrypt.compare(password, user.password);
    if (!isMatch) return null;

    const token = jwt.sign({ id: user.id }, this.secretKey);
    // Store the token in a secure way (not shown here for simplicity)
    return { ...user, password: '' }; // Return user without password for security
  }
}
