// @>npm i jsonwebtoken@^8.5.1 bcryptjs@^2.4.3
import * as jwt from 'jsonwebtoken';
import * as bcrypt from 'bcryptjs';

interface User {
  id: string;
  email: string;
}

class AuthorizationServiceImpl implements AuthorizationService {
  private users: Map<string, User> = new Map();
  private secretKey: string = "your-secret-key"; // replace with your actual secret key

  async register(userData): Promise<User> {
    const hashedPassword = await bcrypt.hash(userData.password, 10);
    const user: User = { id: this.generateUniqueId(), email: userData.email }; // assuming password is hashed and stored securely
    this.users.set(user.id, user);
    return user;
  }

  async login(credentials): Promise<User> {
    const user = this.users.get(credentials.email);
    if (!user) throw new Error("Invalid credentials");

    const isPasswordMatch = await bcrypt.compare(credentials.password, user.password);
    if (!isPasswordMatch) throw new Error("Invalid credentials");

    const token = jwt.sign({ userId: user.id }, this.secretKey, { expiresIn: '1h' });
    // you can return the token to the client here for future authentication
    return user;
  }

  private generateUniqueId(): string {
    return Math.random().toString(36).substr(2, 9); // simple implementation for generating a unique id
  }
}

export default new AuthorizationServiceImpl();
