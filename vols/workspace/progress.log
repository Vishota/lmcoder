🧠 Response for code (Authorization): // @>npm i jsonwebtoken@8.5.1
import * as jwt from 'jsonwebtoken';

interface Credentials { username: string; password: string; }
type SessionToken = string;
const SECRET_KEY = "YOUR_SECRET_KEY";

export class AuthorizationService {
    async authenticateUser(credentials: Credentials): Promise<SessionToken> {
        // In a real-world scenario, you'd need to validate the credentials against a user database.
        // For this example, let's assume they're valid.
        const token = jwt.sign({ username: credentials.username }, SECRET_KEY);
        return token;
    }

    async validateToken(token: SessionToken): Promise<boolean> {
        try {
            jwt.verify(token, SECRET_KEY);
            return true;
        } catch (error) {
            return false;
        }
    }
}
