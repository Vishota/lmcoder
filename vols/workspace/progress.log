  private users: Map<string, User> = new Map();

  async register(userData): Promise<User> {
    const user = this.createUserFromData(userData);
    if (this.users.has(user.email)) {
      throw new Error('Email already exists');
    }
    this.users.set(user.email, user);
    return user;
  }

  async login(credentials): Promise<User> {
    const { email, password } = credentials;
    if (!this.users.has(email)) {
      throw new Error('Invalid email or password');
    }
    // In a real-world application, you would likely be comparing hashed passwords here.
    if (this.users.get(email).password !== password) {
      throw new Error('Invalid email or password');
    }
    return this.users.get(email);
  }

