🧠 Response for code (User Authentication): ```typescript
// @>npm i jsonwebtoken@8.5.1 bcryptjs@2.4.3
import * as jwt from 'jsonwebtoken';
import * as bcrypt from 'bcryptjs';

export class UserAuthenticationService {
  private users: Record<string, string> = {};

  async register(userData: { username: string; password: string }): Promise<User> {
    const { username, password } = userData;
    if (this.users[username]) throw new Error('Username already exists');
    const hashedPassword = await bcrypt.hash(password, 10);
    this.users[username] = hashedPassword;
    return { username };
  }

  async login(credentials: { username: string; password: string }): Promise<User> {
    const { username, password } = credentials;
    const hashedPassword = this.users[username];
    if (!hashedPassword) throw new Error('Invalid credentials');
    const isMatch = await bcrypt.compare(password, hashedPassword);
    if (!isMatch) throw new Error('Invalid credentials');
    const token = jwt.sign({ username }, 'secretKey', { expiresIn: '1h' });
    return { username, token };
  }
}
```
